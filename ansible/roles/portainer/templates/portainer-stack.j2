version: '3.8'

services:
  portainer-agent:
    image: portainer/agent:latest
    environment:
      # REQUIRED: Should be equal to the service name prefixed by "tasks." when
      # deployed inside an overlay network
      AGENT_CLUSTER_ADDR: tasks.portainer-agent
      # AGENT_PORT: 9001
      # LOG_LEVEL: debug

    volumes:
      # Expose the docker socket for modification
      - /var/run/docker.sock:/var/run/docker.sock

      # Expose volumes
      - /var/lib/docker/volumes:/var/lib/docker/volumes

    networks:
      - portainer_agent_network

    deploy:
      mode: global
      placement:
        constraints: [ node.platform.os == linux ]

  portainer:
    image: portainer/portainer-ce:latest
    command: -H tcp://tasks.portainer-agent:9001

    ports:
      - 9000:9000
      - 8000:8000
    volumes:
      - /data/nfs-mount/portainer:/data

    networks:
      - portainer_agent_network
      - traefik-public

    deploy:
      labels:
        traefik.enable: "true"
        traefik.docker.network: traefik-public

        traefik.http.routers.portainer.rule: Host(`portainer.behemythic.com`)
        traefik.http.routers.portainer.entrypoints: websecure
        traefik.http.routers.portainer.tls.certresolver: le
        traefik.http.routers.portainer.service: portainer

        traefik.http.routers.portainer.middlewares: forward-auth@file

        traefik.http.services.portainer.loadbalancer.server.port: 9000

      mode: replicated
      replicas: 1
      placement:
        constraints: [ node.role == manager ]

networks:
  portainer_agent_network:
    driver: overlay
  traefik-public:
    external: true

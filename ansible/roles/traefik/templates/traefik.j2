api:
  dashboard: true

log:
  level: DEBUG

providers:
  docker:
    swarmMode: true
    exposedByDefault: false
  # Enable dynamic configuration
  file:
    directory: /etc/traefik/dynamic
    watch: true

entryPoints:
  web:
    address: :80
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: :443
    http:
      tls:
        certResolver: le
        domains:
          - main: behemythic.com
            sans: "*.behemythic.com"

certificatesResolvers:
  le:
    acme:
      email: asher.norland@gmail.com
      storage: /certs/acme.json
      dnsChallenge:
        provider: "googledomains"

version: '3.8'

services:
  traefik:
    image: traefik:v2.10
    ports:
      - 80:80
      - 443:443
    volumes:
      # Add Docker as a volume to allow Traefik to read containers
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # Certificate data
      - /etc/traefik/certs:/certs
      # Configuration data
      - /etc/traefik/traefik.yml:/etc/traefik/traefik.yml:ro
    networks:
      - traefik-public
    deploy:
      # For Swarm mode, service labels are used https://doc.traefik.io/traefik/providers/docker/#routing-configuration-with-labels_1
      labels:
        traefik.enable: "true"

        # Dashboard domain
        traefik.http.routers.traefik.rule: Host(`traefik.behemythic.com`)
        traefik.http.routers.traefik.entrypoints: websecure
        traefik.http.routers.traefik.tls.certresolver: le
        traefik.http.routers.traefik.service: api@internal

        # Port to use inside a docker service
        traefik.http.services.traefik.loadbalancer.server.port: 8080

      mode: replicated
      replicas: 1
      placement:
        constraints: [ node.role == manager ]

networks:
  traefik-public:
    driver: overlay
    name: traefik-public

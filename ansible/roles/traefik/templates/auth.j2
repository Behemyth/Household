default-provider=generic-oauth
providers.generic-oauth.auth-url=https://github.com/login/oauth/authorize
providers.generic-oauth.token-url=https://github.com/login/oauth/access_token
providers.generic-oauth.user-url=https://api.github.com/user
providers.generic-oauth.client-id={{
    lookup(
        'azure.azcollection.azure_keyvault_secret',
        'behemythic-oauth-client-id',
        vault_url='https://behemyth-vault.vault.azure.net/'
    )
    }}
providers.generic-oauth.client-secret={{
    lookup(
        'azure.azcollection.azure_keyvault_secret',
        'behemythic-oauth-client-secret',
        vault_url='https://behemyth-vault.vault.azure.net/'
    )
    }}
secret={{
    lookup(
        'azure.azcollection.azure_keyvault_secret',
        'traefik-auth-secret',
        vault_url='https://behemyth-vault.vault.azure.net/'
    )
    }}
cookie-domain=behemythic.com
auth-host=auth.behemythic.com
whitelist=asher.norland@gmail.com
